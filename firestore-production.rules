rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Newsletter koleksiyonu - API'den erişim için
    match /newsletters/{document} {
      allow read, write: if true; // API'den erişim için geçici olarak açık
    }
    
    // Users koleksiyonu - sadece admin erişimi
    match /users/{document} {
      allow read, write: if true; // API'den erişim için geçici olarak açık
    }
    
    // Products koleksiyonu - herkese okuma, admin'e yazma
    match /products/{document} {
      allow read: if true;
      allow write: if true; // API'den erişim için geçici olarak açık
    }

    // Dijital katalog kategori ve ürünleri
    match /catalog_categories/{document} {
      allow read, write: if true; // API'den erişim için geçici olarak açık
    }

    match /catalog_products/{document} {
      allow read, write: if true; // API'den erişim için geçici olarak açık
    }

    // Qanta stok senkronunda idempotency için kullanılır
    match /catalog_stock_adjustments/{document} {
      allow read, write: if true; // API'den erişim için geçici olarak açık
    }
    
    // Customers koleksiyonu - API'den erişim
    match /customers/{document} {
      allow read, write: if true; // API'den erişim için geçici olarak açık
    }
    
    // Sales koleksiyonu - sadece admin erişimi
    match /sales/{document} {
      allow read, write: if true; // API'den erişim için geçici olarak açık
    }
    
    // Campaigns koleksiyonu - sadece admin erişimi
    match /campaigns/{document} {
      allow read, write: if true; // API'den erişim için geçici olarak açık
    }
    
    // WhatsApp Templates - sadece admin erişimi
    match /whatsappTemplates/{document} {
      allow read, write: if true; // API'den erişim için geçici olarak açık
    }
    
    // WhatsApp Messages - sadece admin erişimi
    match /whatsappMessages/{document} {
      allow read, write: if true; // API'den erişim için geçici olarak açık
    }
    
    // Events koleksiyonu - herkese okuma, admin'e yazma
    match /events/{document} {
      allow read: if true;
      allow write: if true; // API'den erişim için geçici olarak açık
    }
    
    // Test koleksiyonu - development için
    match /test/{document} {
      allow read, write: if true;
    }

    // Kudat katalog siparişleri - admin paneli ve sipariş API'si için
    match /kudat_orders/{document} {
      allow read, write: if true; // API'den erişim için geçici olarak açık
    }

    // Admin giriş kodu ayarları - API üzerinden yönetilir
    match /admin_settings/{document} {
      allow read, write: if true; // API'den erişim için geçici olarak açık
    }

    // Sunucu tarafı rate-limit sayaçları
    match /server_rate_limits/{document} {
      allow read, write: if true; // API rate-limit kontrolü için
    }
  }
}
